# ==============================================================================
# KAIO Backend — Local & Production Environment Configuration Guide (.env.example)
# Copy this file to `backend/.env` and update values for your environment.
# ==============================================================================

# ── Core Server Configuration ──────────────────────────────────────────────────
# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Logging verbosity: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# Service Port
PORT=8000

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME)
# Note: Escape special characters in password (e.g., '@' as '%40')
DATABASE_URL=postgresql://postgres:Password%40123@localhost:5432/kanban_test_db

# JWT Secret Key used for signing access tokens (Must be >= 32 random characters in production)
JWT_SECRET=kaio_dev_secret_key_change_in_production_min32chars!

# JWT Signing Algorithm & Expiration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (Comma-separated list of trusted frontend URLs, no wildcards in prod)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Production Hardening & Rate Limiting ─────────────────────────────────────
# Maximum allowed payload size for HTTP requests in bytes (Default: 50MB)
MAX_REQUEST_SIZE_BYTES=52428800

# Rate limit cap per client IP per minute
RATE_LIMIT_PER_MINUTE=300


# ── SMTP Email Service (Optional for Invitation & Notification emails) ───────
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password


# ── Meeting Automation Engine (MEETING_* Prefix) ──────────────────────────────
# Google Account credentials used by Playwright Bot to sign into Google Meet
MEETING_GOOGLE_EMAIL=kaiobotmeet@gmail.com
MEETING_GOOGLE_PASSWORD=your_google_bot_password

# Directory storing persistent Chromium profile data (cookies, session state)
MEETING_PROFILE_DIR=storage/meeting/profile

# Display name shown for the bot inside Google Meet rooms
MEETING_BOT_NAME=KAIO Bot

# Headless mode: Set to false for FIRST login (to solve Google CAPTCHA/2FA), then true for production
MEETING_HEADLESS=true

# Meeting Bot Timeouts & Retries
MEETING_JOIN_TIMEOUT=60        # Seconds to wait for admission into meeting room
MEETING_PAGE_TIMEOUT=30000     # Playwright operation default timeout in milliseconds
MEETING_AUTH_TIMEOUT=45        # Max time for Google OAuth flow completion in seconds
MEETING_RETRY_COUNT=3          # Retries for browser launch/navigation failures
MEETING_HEARTBEAT_INTERVAL=5.0 # Health monitor tick frequency in seconds
MEETING_MAX_CONCURRENT_SESSIONS=3 # Maximum concurrent meeting bot sessions per backend instance
MEETING_TIMEOUT=3600           # Maximum meeting session duration in seconds (1 hour)

# Debug & Diagnostics
MEETING_DEBUG_DIR=storage/meeting/debug
MEETING_SCREENSHOT_ON_FAILURE=true


# ── Audio Recording & Subsystem Configuration ──────────────────────────────────
# Path to FFmpeg & FFprobe executables
# Linux / Docker: ffmpeg / ffprobe
# Windows Dev: C:\ffmpeg\bin\ffmpeg.exe
MEETING_FFMPEG_PATH=ffmpeg
MEETING_FFPROBE_PATH=ffprobe

# Audio capture output directory
MEETING_RECORDING_OUTPUT_DIR=storage/meeting/recordings
MEETING_RECORDING_FORMAT=webm
MEETING_RECORDING_SAMPLE_RATE=48000

# PulseAudio / PipeWire Virtual Sink Source (Linux / Docker)
# On Linux / Docker, this must match the virtual monitor source (e.g. kaio_sink.monitor)
RECORDING_PULSE_SOURCE=kaio_sink.monitor
MEETING_RECORDING_PULSE_SOURCE=kaio_sink.monitor

# Windows Local DirectShow Audio Capture Device Name (Windows Dev Only)
# Example: "Stereo Mix (Realtek(R) Audio)" or leave blank to use sine test generator
MEETING_RECORDING_WIN_AUDIO_DEVICE=


# ── AI Processing & Speech Provider Configuration ──────────────────────────────
# Master toggle for AI processing features
AI_ENABLED=true

# Active Speech Provider for STT + Diarization: 'deepgram'
MEETING_SPEECH_PROVIDER=deepgram

# Deepgram API Key (Get from https://console.deepgram.com/)
MEETING_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Deepgram Model: 'nova-3' (Recommended), 'nova-2'
MEETING_DEEPGRAM_MODEL=nova-3

# Language: Leave blank for automatic language detection, or specify (e.g. 'en', 'hi')
MEETING_DEEPGRAM_LANGUAGE=
MEETING_DEEPGRAM_TIMEOUT=300
MEETING_DEEPGRAM_MAX_RETRIES=3

# LLM Intelligence Provider for Task Proposal Extraction: 'gemini' or 'puter'
MEETING_INTELLIGENCE_PROVIDER=gemini
PUTER_API_KEY=your_puter_api_key_optional

# Task Extraction Controls
MEETING_EXTRACTION_MIN_TRANSCRIPT_WORDS=20
MEETING_EXTRACTION_MAX_RETRIES=3
MEETING_EXTRACTION_CHUNK_TOKEN_LIMIT=4000


# ── Storage Backend & Artifact Retention ──────────────────────────────────────
# Storage Provider Backend: 'local', 'r2' (Cloudflare R2), 's3', 'gcs', 'azure'
MEETING_STORAGE_PROVIDER=local

# Cloudflare R2 Credentials (Only required if MEETING_STORAGE_PROVIDER=r2)
MEETING_R2_BUCKET_NAME=kaio-meeting-artifacts
MEETING_R2_ACCOUNT_ID=your_cloudflare_account_id
MEETING_R2_ACCESS_KEY_ID=your_r2_access_key_id
MEETING_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
MEETING_R2_PUBLIC_URL_PREFIX=https://your-bucket-pub-url.r2.dev

# Artifact Retention Policy: 'KEEP_TRANSCRIPT_ONLY' (Default), 'KEEP_ALL', 'KEEP_NOTHING'
# 'KEEP_TRANSCRIPT_ONLY' purges intermediate audio (.webm, .wav) after task extraction completes.
MEETING_ARTIFACT_RETENTION_POLICY=KEEP_TRANSCRIPT_ONLY
MEETING_ARTIFACT_RETENTION_DAYS=30
